{
  "name": "@nlnf/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "tauri:dev": "tauri dev",
    "pretauri:dev:opencv": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/feature_match/check-opencv-env.ps1 -RequireRuntime",
    "tauri:dev:opencv": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/feature_match/run-opencv-tauri.ps1 dev",
    "tauri:dev:opencv:e2e": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/feature_match/run-opencv-tauri.ps1 dev-e2e",
    "tauri:build": "tauri build",
    "tauri:doctor:opencv": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/feature_match/check-opencv-env.ps1 -RequireRuntime",
    "tauri:build:opencv": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/feature_match/run-opencv-tauri.ps1 build",
    "tauri:build:opencv:recall": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/feature_match/run-opencv-tauri.ps1 build-recall",
    "tauri:build:preview": "tauri build --bundles nsis --no-sign --ci"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.2"
  }
}
