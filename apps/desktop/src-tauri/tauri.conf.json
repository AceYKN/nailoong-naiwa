{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NLNF Classifier",
  "version": "0.1.0",
  "identifier": "com.aceykn.nlnfclassifier",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:15420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "奶龙 / 奶蛙识别器",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
